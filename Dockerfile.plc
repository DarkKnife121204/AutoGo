FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /plc-emulator \
    ./cmd/plc-emulator

FROM alpine:3.22

RUN addgroup -S autogo && adduser -S autogo -G autogo

COPY --from=builder /plc-emulator /usr/local/bin/plc-emulator

USER autogo

EXPOSE 5020

ENTRYPOINT ["plc-emulator"]